/* Généré par rca-theme ({{ mode }}) : couleurs de l'interface Firefox. */
:root {
  --rca-bg: {{ background }};
  --rca-bg-dark: {{ dark_background }};
  --rca-bg-darker: {{ darker_background }};
  --rca-bg-light: {{ lighter_background }};
  --rca-fg: {{ foreground }};
  --rca-muted: {{ muted }};
  --rca-accent: {{ accent }};
  --rca-selection: {{ selection }};
}
