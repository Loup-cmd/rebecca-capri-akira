#!/bin/bash
# rca-reminder set <délai> <texte> | list | clear
#   délai : 10m, 1h30m, 45s, ou une heure 18:30
source "$(dirname "$(readlink -f "$0")")/rca-lib.sh"
case "${1:-list}" in
  set)
    delay="${2:-}"; shift 2 2>/dev/null; text="$*"
    [[ -n "$delay" && -n "$text" ]] || { echo "usage: rca-reminder set <délai> <texte>" >&2; exit 1; }
    unit="rca-reminder-$(date +%s%N | tail -c 7)"
    if [[ "$delay" =~ ^[0-9]{1,2}:[0-9]{2}$ ]]; then when=(--on-calendar="$(date +%F) $delay:00")
    else when=(--on-active="$delay"); fi
    systemd-run --user --quiet --unit="$unit" --description="$text" "${when[@]}" \
      notify-send -a "Rappel" -u critical "Rappel" "$text" || exit 1
    rca_notify -t 2000 "Rappel programmé" "$delay — $text"
    ;;
  list)
    systemctl --user list-timers --all --output=json 2>/dev/null \
      | jq -r '.[] | select(.unit | startswith("rca-reminder-")) | "\(.next)\t\(.activates)"' \
      | while IFS=$'\t' read -r next svc; do
          desc="$(systemctl --user show -p Description --value "$svc" 2>/dev/null)"
          [[ "$next" =~ ^[0-9]+$ ]] && next="$(date -d "@$(( next / 1000000 ))" +%H:%M)"
          printf '%s\t%s\n' "$next" "$desc"
        done
    ;;
  clear)
    systemctl --user stop 'rca-reminder-*.timer' 2>/dev/null
    rca_notify -t 1500 "Rappels" "Tous les rappels sont effacés"
    ;;
esac
