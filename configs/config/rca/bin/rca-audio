#!/bin/bash
# rca-audio up|down [pas] | mute | mic-mute | next-output
# Le shell affiche l'OSD tout seul (il suit PipeWire).
source "$(dirname "$(readlink -f "$0")")/rca-lib.sh"
step="${2:-5}"
case "${1:-}" in
  up) wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "${step}%+" ;;
  down) wpctl set-volume @DEFAULT_AUDIO_SINK@ "${step}%-" ;;
  mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  mic-mute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; rca_qs osd mic ;;
  next-output)
    mapfile -t sinks < <(pactl -f json list sinks 2>/dev/null | jq -r '.[].name')
    current="$(pactl get-default-sink)"
    (( ${#sinks[@]} > 1 )) || exit 0
    for i in "${!sinks[@]}"; do [[ "${sinks[$i]}" == "$current" ]] && break; done
    next="${sinks[$(( (i + 1) % ${#sinks[@]} ))]}"
    pactl set-default-sink "$next"
    rca_notify -t 1500 "Sortie audio" "$(pactl -f json list sinks | jq -r --arg n "$next" '.[] | select(.name == $n) | .description')"
    ;;
  *) echo "usage: rca-audio up|down [pas] | mute | mic-mute | next-output" >&2; exit 1 ;;
esac
