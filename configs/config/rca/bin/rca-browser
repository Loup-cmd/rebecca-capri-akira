#!/bin/bash
# rca-browser [--private] [url] — navigateur par défaut (repli : Firefox).
source "$(dirname "$(readlink -f "$0")")/rca-lib.sh"

private=0
[[ "${1:-}" == --private ]] && { private=1; shift; }

desktop="$(xdg-settings get default-web-browser 2>/dev/null)"
exec_line=""
for dir in "${XDG_DATA_HOME:-$HOME/.local/share}" /usr/local/share /usr/share; do
  [[ -n "$desktop" && -f "$dir/applications/$desktop" ]] || continue
  exec_line="$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$dir/applications/$desktop" | head -1)"
  break
done
# Le lanceur d'Omarchy ne survit pas à sa désinstallation.
[[ -z "$exec_line" || "$exec_line" == omarchy-* ]] && exec_line=firefox

if (( private )); then
  case "$exec_line" in
    *firefox*|*librewolf*|*zen*) set -- --private-window "$@" ;;
    *) set -- --incognito "$@" ;;
  esac
fi
rca_launch "$exec_line" "$@"
