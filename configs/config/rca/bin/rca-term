#!/bin/bash
# rca-term [--pid=PID] [--files|--editor] [-- commande…]
# Ouvre kitty (ou Nautilus, ou l'éditeur) dans le dossier du terminal actif.
source "$(dirname "$(readlink -f "$0")")/rca-lib.sh"

pid="" target=terminal
while (( $# )); do
  case "$1" in
    --pid=*) pid="${1#--pid=}"; shift ;;
    --files) target=files; shift ;;
    --editor) target=editor; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done

cwd="$HOME"
if [[ -z "$pid" ]]; then
  pid="$(hyprctl activewindow -j 2>/dev/null | jq -r '.pid // empty')"
fi
if [[ -n "$pid" && "$pid" -gt 0 ]]; then
  # Le shell enfant du terminal porte le dossier courant.
  child="$(pgrep -P "$pid" | tail -n1)"
  dir="$(readlink "/proc/${child:-$pid}/cwd" 2>/dev/null)"
  [[ -n "$dir" && -d "$dir" && "$dir" != "/" ]] && cwd="$dir"
fi

case "$target" in
  files) rca_launch nautilus --new-window "$cwd" ;;
  editor)
    editor="${EDITOR:-nvim}"
    case "$editor" in
      nvim|vim|vi|nano|helix|hx|micro) rca_launch kitty --directory "$cwd" -e "$editor" ;;
      *) rca_launch "$editor" ;;
    esac
    ;;
  *)
    if (( $# )); then rca_launch kitty --directory "$cwd" -e "$@"
    else rca_launch kitty --directory "$cwd"; fi
    ;;
esac
